TELEGRAM_BOT_TOKEN=put-your-token-here

# --- Optional overrides (defaults shown) ---
# How often the scrape/notify cycle runs, in seconds.
CHECK_INTERVAL_SECONDS=900
# SQLite database path (persisted via the ./out volume).
DB_PATH=out/bot.db
# Layer rentlyfly.ai (Tel Aviv Facebook Groups) on top of Yad2 for TLV searches.
ENABLE_RENTLYFLY=1
# When a monitor starts (or after edit/unmute), send up to this many current
# matches (newest first) as a sample, then only-new afterwards.
BACKFILL_CAP=10
