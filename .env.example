TELEGRAM_BOT_TOKEN=put-your-token-here
# Chats allowed to use the bot (comma-separated; group ids are negative). Empty = nobody.
# The bot logs the id of every chat it ignores, so you can find yours there.
ALLOWED_CHAT_IDS=-1000000000
# Telegram user ids allowed to give commands inside those chats (empty = any member).
# The log line 'by <name> (user <id>)' shows each person's id.
ALLOWED_USER_IDS=111111111,222222222

# --- Optional overrides (defaults shown) ---
# How often the Yad2 scrape/notify cycle runs, in seconds.
CHECK_INTERVAL_SECONDS=900
# SQLite database path (persisted via the ./out volume).
DB_PATH=out/bot.db
# When a monitor starts, send up to this many current Yad2 listings (newest first)
# as a sample, then only-new afterwards.
BACKFILL_CAP=10

# --- Facebook groups (needs the bot+Facebook container: deploy/aptbot-fb/) ---
FB_ENABLED=1
# Groups to watch, comma-separated (default: the Tel Aviv rental groups in aptbot/config.py).
# FB_GROUP_IDS=
FB_MAX_TABS=2
# Page-load timeout in seconds. On a Raspberry Pi 3 use 120 (and FB_MAX_TABS=1 to save RAM).
# FBGB_NAV_TIMEOUT=45
# Per-request limit for one Facebook job, seconds (Pi 3: 600).
# FB_REQUEST_TIMEOUT=240
# Poll interval, jittered between these (seconds).
FB_POLL_MIN_SECONDS=480
FB_POLL_MAX_SECONDS=720
# No polling in these Israel-time hours ("" = around the clock).
FB_QUIET_HOURS=01-07
# Browser engine: chrome (Patchright + Xvfb) or oxide (BrowserOxide, fits a 1 GB Pi). oxide reads its session from
# FB_OXIDE_JAR (default <FBGB_HOME>/oxide_jar.json; make it with aptbot/browsers/oxide/tools/chrome_to_jar.py).
FB_BROWSER=chrome
# FB_OXIDE_JAR=
# Newest posts sent as a taster when a monitor starts.
FB_BACKFILL_CAP=5

# --- AI summaries of Facebook posts (aptbot/listing_ai; ChatGPT subscription OAuth) ---
# Needs a one-time `python -m aptbot.listing_ai login`. Off when 0 or when no login exists.
AI_ENABLED=0
AI_MODEL=gpt-6-luna
AI_EFFORT=low
# Posts per model call, and how many calls run at once.
AI_BATCH=15
AI_CONCURRENCY=3
AI_TIMEOUT=120
# Which post kinds are sent (comma-separated; empty = all): rent, roommate, sublet, sale,
# seeking, not_listing. Posts without an AI analysis are always sent.
FB_POST_KINDS=rent
# Token store (keep it OUTSIDE the repo). Default: ~/.aptbot/chatgpt-auth.json
# AI_AUTH_PATH=
